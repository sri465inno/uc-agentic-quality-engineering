{
  "openapi": "3.0.3",
  "info": {
    "title": "hotel-service",
    "version": "1.0.0",
    "description": "Hotel booking platform release 1.0: the endpoints hotel-service exposes. /api/admin/* operations are internal test hooks (x-internal)."
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "local default port"
    }
  ],
