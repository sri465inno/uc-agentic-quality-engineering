      "_site": "https://tcs-team-ou6drgfr.atlassian.net",
      "fields": {
        "summary": "3.1 Search hotels by destination and date range",
        "description": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Epic: ",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "Epic 1: Search and Availability"
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "User story"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "As a guest, I want to search by destination and stay dates so that I can find hotels for my trip."
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Description"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Capture destination, check-in, check-out, rooms, adults, and children."
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Acceptance criteria"
                }
              ]
            },
            {
              "type": "orderedList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Given valid search criteria, when the guest submits the search, then a search request is created and matching available hotels are returned."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The submitted criteria remain visible and editable on the results page."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Past check-in dates, check-out dates not after check-in, and missing mandatory fields are rejected with actionable messages."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A no-availability result explains that no matching inventory was found and allows criteria changes."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Business rules"
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Check-in must precede check-out."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Occupancy must comply with configured room limits."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Maximum stay length must be configurable."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Dependencies"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Availability service, Property service"
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Logging and audit requirements"
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Correlation ID"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Search timestamp"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Destination token or code"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Date range"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Room and occupancy counts"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Result count"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Response status and duration"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Do not log guest names, email addresses, payment data, or raw free-text containing personal data"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Story points (indicative): ",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "8 – to be confirmed in refinement"
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Notes for refinement"
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
