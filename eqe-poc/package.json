{
  "name": "eqe-poc",
  "version": "0.1.0",
  "description": "Devin AI for QE - 3-week PoC (UC1 initiative -> approved test design, UC2 approved cases -> Playwright). Stages 1-3 only.",
  "private": true,
  "scripts": {
    "app": "node apps/demo-booking/server.js",
    "jira": "node scripts/jira.js",
    "build:artifacts": "node scripts/build-artifacts.js",
    "compare:golden": "node scripts/compare-golden.js",
    "test:e2e": "playwright test",
    "flake": "node scripts/flake-run.js",
    "metrics": "node scripts/metrics.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/lint.js",
    "test": "node --test test/*.test.js"
  },
  "engines": { "node": ">=20" },
  "license": "UNLICENSED",
  "dependencies": {
    "@playwright/test": "1.63.0",
    "exceljs": "4.4.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
